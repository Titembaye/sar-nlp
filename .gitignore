# ---- Environnements Python ----
.venv/
venv/
env/
ENV/
*.egg-info/

# ---- Secrets / config locale ----
.env
.env.local
*.local

# ---- Caches Python / notebooks ----
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ipynb_checkpoints/
.ruff_cache/
.mypy_cache/

# ---- IDE / OS ----
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---- Modèles / checkpoints entraînés (volumineux, régénérables) ----
models/
*.safetensors
*.bin
*.pt
*.ckpt
*.gguf

# ---- Sorties temporaires ----
*.log
.cache/
tmp_*
scratch/
outputs/
wandb/

# ---- Données ----
# Les gros fichiers et données sous droits sont suivis par DVC :
# voir data/*.dvc (dans git) et data/.gitignore (généré par DVC).
# data/samples/ et data/README.md restent dans git.

# ---- PDF : ignorés par défaut sauf le projet de thèse ----
*.pdf
!/docs/projet_these*.pdf

# ---- docs/ : notes de travail internes, non publiées (README = façade publique) ----
# Seul le PDF du projet de thèse (règle ci-dessus) reste dans le repo.
/docs/*
!/docs/projet_these*.pdf

# ---- Exclus du repo pour l'instant ----
/run.py
